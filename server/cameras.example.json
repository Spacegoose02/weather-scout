{
  "_readme": "Copy to /data/cameras.json. Put API keys in environment variables and reference them with keyEnv, never in this file. Types: ibi511 (IBI/Castle Rock 511 developer API), geojson (any GeoJSON point layer, e.g. ArcGIS f=geojson), static (your own cameras).",
  "feeds": [
    {
      "id": "va",
      "name": "Virginia 511 (VDOT)",
      "region": "VA",
      "type": "geojson",
      "enabled": false,
      "url": "PASTE_THE_CAMERA_GEOJSON_URL_FROM_VDOT_SMARTERROADS",
      "keyEnv": "VDOT_SMARTERROADS_TOKEN",
      "keyParam": "token",
      "fields": { "id": "id", "name": "description", "image": "image_url", "video": "rtmp_url", "road": "route" },
      "refreshMinutes": 15
    },
    {
      "id": "ny",
      "name": "511NY",
      "region": "NY",
      "type": "ibi511",
      "enabled": false,
      "baseUrl": "https://511ny.org",
      "keyEnv": "NY511_API_KEY",
      "refreshMinutes": 15
    },
    {
      "id": "home",
      "name": "My cameras",
      "type": "static",
      "enabled": false,
      "cameras": [
        { "id": "porch", "name": "Porch sky cam", "lat": 37.54, "lon": -77.43, "image": "http://192.168.1.50/snapshot.jpg" }
      ]
    }
  ]
}
