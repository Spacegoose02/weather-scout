{
  "_readme": "Copy to /data/cameras.json to customize. Without this file, Weather Scout uses the built-in Virginia, South Carolina, Maryland, Kentucky and Delaware feeds (plus North Carolina, New York, Georgia and Ohio when NC_DRIVENC_API_KEY, NY511_API_KEY, GA511_API_KEY or OHGO_API_KEY is set). Put any API keys in environment variables and reference them with keyEnv, never in this file. Types: ibi511 (IBI/Castle Rock 511 developer API), ohgo (Ohio OHGO API), geojson (any GeoJSON point layer), arcgis (ArcGIS layer URL, paged), static (your own cameras).",
  "feeds": [
    {
      "id": "va",
      "name": "511 Virginia (VDOT)",
      "region": "VA",
      "type": "geojson",
      "url": "https://511.vdot.virginia.gov/services/511/map/layers/map/cams",
      "fields": {
        "id": "id",
        "name": "description",
        "image": "image_url",
        "video": "https_url",
        "road": "route",
        "direction": "direction",
        "active": "active",
        "problem": "problem_stream"
      },
      "refreshMinutes": 15
    },
    {
      "id": "sc",
      "name": "511 South Carolina (SCDOT)",
      "region": "SC",
      "type": "geojson",
      "url": "https://sc.cdn.iteris-atis.com/geojson/icons/metadata/icons.cameras.geojson",
      "fields": {
        "id": "name",
        "name": "description",
        "image": "image_url",
        "video": "https_url",
        "road": "route",
        "direction": "direction",
        "active": "active",
        "problem": "problem_stream"
      },
      "refreshMinutes": 15
    },
    {
      "id": "md",
      "name": "Maryland CHART",
      "region": "MD",
      "type": "arcgis",
      "url": "https://geodata.md.gov/imap/rest/services/Transportation/MD_TrafficCameras/MapServer/0",
      "fields": {
        "id": "feedID",
        "name": "location",
        "embed": "url"
      },
      "refreshMinutes": 60
    },
    {
      "id": "ky",
      "name": "Kentucky (KYTC)",
      "region": "KY",
      "type": "arcgis",
      "url": "https://kygisserver.ky.gov/arcgis/rest/services/WGS84WM_Services/Ky_WebCams_WGS84WM/MapServer/0",
      "fields": {
        "id": "OBJECTID",
        "name": "description",
        "image": "snapshot",
        "road": "highway",
        "direction": "direction"
      },
      "refreshMinutes": 60
    },
    {
      "id": "de",
      "name": "Delaware (DelDOT)",
      "region": "DE",
      "type": "arcgis",
      "url": "https://enterprise.firstmaptest.delaware.gov/arcgis/rest/services/Transportation/DE_TMC_Traffic_Feeds/FeatureServer/1",
      "fields": {
        "id": "ID",
        "name": "TITLE",
        "video": "M3U8S",
        "active": "ENABLED"
      },
      "pageSize": 1000,
      "refreshMinutes": 60
    },
    {
      "id": "nc",
      "name": "DriveNC (NCDOT)",
      "region": "NC",
      "type": "ibi511",
      "apiVersion": 2,
      "baseUrl": "https://www.drivenc.gov",
      "keyEnv": "NC_DRIVENC_API_KEY",
      "refreshMinutes": 15
    },
    {
      "id": "ny",
      "name": "511NY (NYSDOT)",
      "region": "NY",
      "type": "ibi511",
      "apiVersion": 2,
      "baseUrl": "https://511ny.org",
      "keyEnv": "NY511_API_KEY",
      "refreshMinutes": 15
    },
    {
      "id": "ga",
      "name": "511 Georgia (GDOT)",
      "region": "GA",
      "type": "ibi511",
      "apiVersion": 2,
      "baseUrl": "https://511ga.org",
      "keyEnv": "GA511_API_KEY",
      "refreshMinutes": 15
    },
    {
      "id": "oh",
      "name": "OHGO (ODOT)",
      "region": "OH",
      "type": "ohgo",
      "baseUrl": "https://publicapi.ohgo.com",
      "keyEnv": "OHGO_API_KEY",
      "refreshMinutes": 15
    },
    {
      "id": "home",
      "name": "My cameras",
      "type": "static",
      "enabled": false,
      "cameras": [
        {
          "id": "porch",
          "name": "Porch sky cam",
          "lat": 37.54,
          "lon": -77.43,
          "image": "http://192.168.1.50/snapshot.jpg"
        }
      ]
    }
  ]
}
