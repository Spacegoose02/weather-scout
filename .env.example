# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# ---- basics ------------------------------------------------------------------
PORT=8080
DEFAULT_LOCATION_NAME=Richmond, VA
DEFAULT_LAT=37.5407
DEFAULT_LON=-77.4360
DEFAULT_UNITS=imperial
# NWS asks for an app name and a way to contact you, e.g. "WeatherScout (you@example.com)"
NWS_USER_AGENT=WeatherScout (you@example.com)

# ---- sign-in -------------------------------------------------------------------
# false = anyone on your network can see the weather; sign-in just saves preferences.
AUTH_REQUIRED=false
# First admin. Or leave blank and create the admin on first visit.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set to true when serving over https so cookies are only sent securely.
SECURE_COOKIES=false

# tinyauth / forward-auth SSO. Only turn on when the app is ONLY reachable through the proxy.
AUTH_TRUST_PROXY_HEADERS=false
AUTH_PROXY_USER_HEADER=Remote-User
AUTH_PROXY_EMAIL_HEADER=Remote-Email
AUTH_PROXY_NAME_HEADER=Remote-Name
AUTH_AUTO_CREATE_SSO_USERS=true
SSO_LOGOUT_URL=

# ---- camera feeds ----------------------------------------------------------------
# Built-in camera feeds: va, sc, md, ky (no keys) and nc (needs the key below).
# true = all, false = none, or a list like va,md,nc
CAMERAS_DEFAULT_FEEDS=true

# Severe weather push notifications. Browsers only allow these on https (or localhost).
# Keys are generated into /data/.vapid.json on first start; set these only to pin them.
PUSH_ENABLED=true
PUSH_POLL_SECONDS=120
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# North Carolina: free developer key from drivenc.gov (sign up, then API Documentation page)
NC_DRIVENC_API_KEY=
# Extra feeds go in /data/cameras.json (copy server/cameras.example.json).
# Their API keys go here and are referenced by name with "keyEnv".
NY511_API_KEY=

# ---- AI helper (optional) --------------------------------------------------------
# "Ask an Expert" / "Ask Rocky" chat, cloud photo identifier and web search.
# Runs on Claude (key from console.anthropic.com) or your own Ollama. Leave both blank to keep it off.
# anthropic | ollama | off. Blank = whichever is set up, Claude first.
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Ollama, e.g. http://192.168.1.20:11434. The model must be pulled there (ollama pull gemma3).
OLLAMA_URL=
OLLAMA_MODEL=gemma3
# Only if the chat model can't see photos, e.g. qwen2.5vl
OLLAMA_VISION_MODEL=
# Free ollama.com key, only for "Search the web" with Ollama
OLLAMA_API_KEY=
AI_WEB_SEARCH=true
# Questions + photos per person per day (0 = no limit)
AI_DAILY_LIMIT=40

# ---- read-aloud voice (optional) ---------------------------------------------------
# Kokoro-FastAPI container (ghcr.io/remsky/kokoro-fastapi-cpu), e.g. http://192.168.1.20:8880.
# Blank = the device's own voice.
KOKORO_URL=
KOKORO_VOICE=af_heart
KOKORO_SPEED=1

# "Use approximate location" looks up this connection's public IP at ipapi.co when the
# browser won't share GPS (plain http, or permission denied). Set to false to turn off.
IP_LOCATION=true
